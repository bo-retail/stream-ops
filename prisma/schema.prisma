// StreamOps — scheduling for the live-selling team.
//
// The unit of work is a SHOW: one platform, one slot (day or night), on one
// date. Every show is run by two people, and the two are interchangeable — they
// split the show between camera and computer and swap halfway. The app does not
// track who is doing which job at any moment, because nobody needs it to: a show
// simply needs two names against it.
//
// Four shows a day: TikTok day, TikTok night, eBay day, eBay night. The boss can
// change any show's hours, cancel one that is not running, or bring it back,
// without touching the rest of the week.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What somebody may do.
///
/// Paired with `Team` to make a position: BOSS is the admin, MANAGER on the
/// shipping side is the Shipping Director, and EMPLOYEE is everybody else.
/// `requireBoss` tests for BOSS exactly, so adding MANAGER kept the new role
/// out of every admin page without touching that guard.
enum Role {
  EMPLOYEE
  /// Runs one side of the business without administering the app.
  MANAGER
  BOSS
}

/// Which side of the business somebody works on.
///
/// Streamers are scheduled onto shows and their hours are measured against the
/// shift they were on. Shipping has no schedule at all — they clock the hours
/// they work, and those hours count exactly as clocked.
enum Team {
  STREAMING
  SHIPPING
}

/// Which of the two things being sold: watches, or diamonds.
///
/// Not two apps and not two databases. A diamond show is simply another show on
/// the schedule, run by the same company, packed on the same table by the same
/// people, and paid in the same payroll run. What it needs a column for is that
/// both sell on TikTok at the same hours, under separate seller accounts — so
/// "TikTok Day on the 16th" is two different shows, and nothing else on the row
/// can tell them apart.
///
/// A release chooses one when it is created, and every show in it inherits it.
///
/// The default of WATCH is a migration device: every row that existed before
/// diamonds is a watch row. It comes off once every write states its business.
enum Business {
  WATCH
  DIAMOND
}

enum Platform {
  TIKTOK
  EBAY
}

/// Which of the day's two shows. Times come from settings and can be overridden
/// on any individual show.
enum Slot {
  DAY
  NIGHT
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

/// Where a release is in its life.
///
/// DRAFT  — the boss is still building it. Nobody else can see it.
/// OPEN   — sent out. Streamers can offer shows.
/// CLOSED — no longer taking answers. The schedule gets built from it.
enum ReleaseStatus {
  DRAFT
  OPEN
  CLOSED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               Role     @default(EMPLOYEE)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  team Team @default(STREAMING)

  /// This person's own hourly rate in whole cents, when it differs from their
  /// team's. Null means "whatever the team is paid", which is the normal case.
  hourlyRateCents Int?
  /// This person's own commission in basis points, when it differs. Streamers
  /// only; null means the standard rate.
  commissionBps   Int?

  availability      Availability[]
  releaseMemberships ReleaseMember[]
  submissions       AvailabilitySubmission[]
  assignments       Assignment[]
  assignmentsMade   Assignment[]            @relation("AssignedBy")
  timeOff           TimeOff[]
  timeOffRecorded   TimeOff[]               @relation("TimeOffRecordedBy")
  releasesCreated   Release[]               @relation("ReleaseCreatedBy")
  releasesPublished Release[]               @relation("ReleasePublishedBy")
  priorities        ReleasePriority[]
  snapshotsCreated  ScheduleSnapshot[]      @relation("SnapshotCreatedBy")
  auditLogs         AuditLog[]              @relation("AuditActor")
  timeEntries       TimeEntry[]
  timeEntriesEdited TimeEntryRevision[]     @relation("TimeEntryChangedBy")

  importsUploaded ImportBatch[] @relation("ImportUploadedBy")
  packagesClosed  Package[]     @relation("PackageClosedBy")
  reportsDismissed DismissedReport[] @relation("ReportDismissedBy")
  scans           ScanEvent[]   @relation("ScanBy")

  @@index([role, isActive])
}

/// One scheduling period: the 1st to the 15th, or the 16th to the end of the
/// month.
///
/// Deliberately not Monday-to-Sunday. The schedule is released and worked in the
/// same blocks the business pays in, so a rota never straddles a pay boundary
/// and nothing has to be split by hand.
/// One request for availability, and everything that follows from it.
///
/// The boss composes each release himself: which days it covers, which shows
/// run on them, at what times, and which rules apply when the schedule is
/// generated. Nothing is inherited from a settings page, because in this
/// business there is no default fortnight — one week is four shows a day and
/// the next is two.
///
/// Dates are whatever he picks. Payroll stays on the 1st–15th and 16th–end
/// split regardless; a release may sit inside one of those, span both, or cover
/// three days. The two are deliberately not tied together.
model Release {
  id String @id @default(cuid())

  /// Watches or diamonds. Chosen when the release is created; every show in it
  /// inherits it, and it is what separates two TikTok Day shows on one date.
  business Business @default(WATCH)

  /// What he calls it. Optional — the dates are the real identity.
  name      String?
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status     ReleaseStatus @default(DRAFT)
  dueAt      DateTime?
  releasedAt DateTime?
  closedAt   DateTime?

  /// The schedule built from this release. Version 0 means never published.
  scheduleStatus ScheduleStatus @default(DRAFT)
  version        Int            @default(0)
  publishedAt    DateTime?
  publishedById  String?

  /* ---- the rules, chosen here and nowhere else ------------------------- */

  /// Give the people named in `priorities` first refusal.
  usePriority Boolean @default(false)

  /// Split the work in proportion to how much each person offered, so somebody
  /// available for thirty shows gets roughly three times somebody available for
  /// ten. Off means an even spread regardless of how much anyone offered.
  useProportional Boolean @default(true)

  /// Optional cap on how many shows one person may be given from this release.
  maxShowsPerPerson Int?

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?               @relation("ReleaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?               @relation("ReleasePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  shows       Show[]
  members     ReleaseMember[]
  priorities  ReleasePriority[]
  availability Availability[]
  submissions AvailabilitySubmission[]
  snapshots   ScheduleSnapshot[]

  @@index([status, startDate])
  @@index([scheduleStatus, startDate])
}

/// Who a release is for.
///
/// Two things at once, deliberately: these are the people asked for their
/// availability, and the only people who may be seated on its shows. Keeping
/// them as one list means the answer to "why is she not in the picker" is
/// always "she was not on the release", rather than two settings that can
/// disagree.
///
/// It is what replaces a permanent job title. A streamer is not a *watch*
/// streamer or a *diamond* streamer — she is on this release or she is not, and
/// that can differ from one fortnight to the next.
///
/// **An empty list means everybody.** Every release created before this existed
/// genuinely did go to every streamer, and reading it that way is what lets
/// those releases keep working untouched. Going forward the composer always
/// writes rows and refuses to send a release to nobody, so an empty list only
/// ever means "made before we chose".
model ReleaseMember {
  id        String   @id @default(cuid())
  releaseId String
  userId    String
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([releaseId, userId])
  @@index([releaseId])
  @@index([userId])
}

/// Who gets first refusal on one release.
///
/// Chosen per release rather than stored on the person: who is worth
/// prioritising changes with what the fortnight needs, and a standing setting
/// quietly keeps applying long after the reason for it has gone.
model ReleasePriority {
  id        String @id @default(cuid())
  releaseId String
  userId    String
  /// Higher goes first, so two people can be ranked against each other.
  rank      Int    @default(1)

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([releaseId, userId])
  @@index([releaseId])
}

/// One show: a platform, a slot, a date, and the hours it actually runs.
///
/// Hours live here rather than only in settings so the boss can lengthen or
/// shorten a single show — "Friday's TikTok night runs an extra hour" — without
/// that becoming the default for every other night.
model Show {
  id        String     @id @default(cuid())
  releaseId String
  /// Denormalised from the release, so a show can be found and keyed by
  /// business without a join. See the unique key below.
  business  Business   @default(WATCH)
  date      DateTime   @db.Date
  platform  Platform
  slot      Slot
  startsAt  DateTime
  endsAt    DateTime
  status    ShowStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  release     Release      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  timeEntries TimeEntry[]

  /// One show per business, platform and slot on a given date. Also what stops
  /// two overlapping releases both claiming the same show.
  ///
  /// The business is in the key because both sell on TikTok at the same hours —
  /// the diamond show on 09/15 ran 10:32–16:01 Pacific against the watch day
  /// show's 10:06–16:05. Without it there could be exactly one TikTok Day show
  /// in the world on a given date, and the second one saved would be refused by
  /// the database with nothing in the app able to explain why.
  @@unique([business, date, platform, slot])
  @@index([releaseId, date])
  @@index([status, date])
  @@index([business, date])
}

/// One of the two people on a show.
///
/// `seat` is 1 or 2 and carries no meaning beyond keeping a show to two people —
/// the pair are interchangeable and swap jobs halfway through.
///
/// Two unique constraints do the real work. (show, seat) caps a show at two
/// people and stops two racing edits filling the same slot. (show, user) stops
/// one person being counted as both, which no amount of application code can
/// guarantee on its own.
model Assignment {
  id           String   @id @default(cuid())
  showId       String
  userId       String
  seat         Int
  assignedById String?
  createdAt    DateTime @default(now())

  show       Show  @relation(fields: [showId], references: [id], onDelete: Cascade)
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([showId, seat])
  @@unique([showId, userId])
  @@index([userId])
}

/// "I can work this show." One row per date and slot the person offers.
///
/// Deliberately carries no platform: streamers say when they are free, and the
/// boss decides which platform that lands on.
model Availability {
  id        String   @id @default(cuid())
  userId    String
  releaseId String
  /// Denormalised from the release, for the unique key below.
  business  Business @default(WATCH)
  date      DateTime @db.Date
  slot      Slot
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  /// One answer per person, per business, per slot.
  ///
  /// The business belongs here for the same reason it belongs on a show: a
  /// watch release and a diamond release covering the same fortnight would
  /// otherwise collide the moment somebody was on both and answered both.
  @@unique([userId, business, date, slot])
  @@index([userId, releaseId])
  @@index([releaseId, date])
}

/// Tracks who has actually submitted for a period, as distinct from someone who
/// simply has no free shows to offer.
/// "I have finished answering this release."
///
/// A row here is the difference between a draft somebody is still tapping at
/// and an answer the scheduler may use.
model AvailabilitySubmission {
  id          String   @id @default(cuid())
  userId      String
  releaseId   String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([releaseId])
}

/// "I cannot work at all on these days." Applies immediately: the boss is warned
/// if they schedule the person anyway.
model TimeOff {
  id           String   @id @default(cuid())
  userId       String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("TimeOffRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([userId, startDate, endDate])
  @@index([startDate, endDate])
}

/// Immutable copy of a period's shows at the moment it was published, so an
/// earlier published schedule can always be reconstructed.
model ScheduleSnapshot {
  id          String   @id @default(cuid())
  releaseId   String
  version     Int
  payload     Json
  createdById String
  createdAt   DateTime @default(now())

  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SnapshotCreatedBy", fields: [createdById], references: [id])

  @@unique([releaseId, version])
}

/// A missing-report day somebody has taken off the dashboard.
///
/// The dashboard is a list of things needing attention now, and a day that has
/// been dealt with some other way — a show that never really ran, a report that
/// is not coming — sits there forever otherwise. A banner nobody can clear is a
/// banner people stop reading, and then the one that matters goes unread too.
///
/// It hides the day from the dashboard and nowhere else. Sales report entry
/// still lists it as missing, and says who cleared it and when, because that
/// page is the record of what has actually been loaded rather than a to-do
/// list. Nothing about the day's data changes.
///
/// Keyed by the date, so clearing one clears it for the whole team: it is a
/// shared job, and one person settling it should settle it for everybody.
model DismissedReport {
  showDate DateTime @id @db.Date

  dismissedById String?
  dismissedAt   DateTime @default(now())

  dismissedBy User? @relation("ReportDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
}

/// Business configuration. Single row, id "singleton".
/// The handful of things that really are the same every time.
///
/// Show hours, the show list and the scheduling rules all used to live here as
/// standing defaults. They moved onto the release: this business does not have
/// a default fortnight, and a default that is wrong most weeks is worse than no
/// default at all.
/// What each business pays, and how many people run one of its shows.
///
/// Split out of `Settings` because these are the things that differ between
/// watches and diamonds. Sharing them would mean a rate change on one side
/// quietly moving what the other pays. The timezone stays on `Settings`: it is
/// one company in one place, and two timezones would be a bug.
///
/// No hourly rates here, deliberately. Packers handle both piles off the same
/// table and never clock against a show, so there is nothing to attribute their
/// hours to. And a streamer works one kind of show, so a diamond streamer paid
/// differently is given her own rate on her row — splitting the hourly rate by
/// business as well would mean dividing one person's shift across two rates,
/// which nothing in the business actually does. Both stay in `Settings`.
///
/// Keyed by the business itself, so there is no id to get wrong and no way to
/// end up with two rows for one side.
model BusinessSettings {
  business Business @id

  /// A streamer's share of the show's sales, in basis points — 100 = 1.00%.
  /// Each person on the show earns it separately.
  ///
  /// Worth setting apart from watches: the 09/15 diamond show averaged $257 a
  /// piece against roughly $100 for a watch, so the same percentage is a very
  /// different amount of money.
  streamerCommissionBps Int @default(100)

  updatedAt DateTime @updatedAt
}

model Settings {
  id       String @id @default("singleton")
  timezone String @default("America/New_York")

  /// What a streamer is paid an hour, in whole cents. Everyone earns hourly.
  streamerHourlyCents Int @default(0)
  /// What somebody on shipping is paid an hour, in whole cents.
  shippingHourlyCents Int @default(0)

  /// A streamer's share of their show's sales, in basis points — 100 = 1.00%.
  ///
  /// Basis points rather than a percentage so a rate like 1.25% is an integer
  /// and never a float that drifts. Both people on a show earn it separately,
  /// so a show at 1% pays out 2% of its sales in total.
  streamerCommissionBps Int @default(100)

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  summary    String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

/// Who created or last changed a time entry.
enum TimeEntrySource {
  /// The person clocked themselves in or out.
  SELF
  /// An admin entered or corrected it on their behalf.
  ADMIN
  /// Written from the published schedule when the show started.
  ///
  /// Streamers do not clock for their shows: being on a published schedule is
  /// the commitment, so the hours are printed as the show begins and then stay
  /// put. Editing the show afterwards does not move them — a correction goes
  /// through the timesheet like any other, with a reason and a kept history.
  SCHEDULE
}

/// One clock-in, and the clock-out that closes it.
///
/// `clockInAt` and `clockOutAt` are always the raw truth: the moment somebody
/// actually pressed the button. They are never adjusted, because the audit has
/// to be able to say what really happened.
///
/// What gets *paid* is derived from them. For a streamer the entry is linked to
/// the show they were on, and the paid window is the overlap between the two:
/// clocking in early does not start the clock early, and staying late does not
/// extend it, but arriving late or leaving early comes off. For shipping — and
/// for any entry with no show attached — the raw times are the paid times.
model TimeEntry {
  id         String    @id @default(cuid())
  userId     String
  clockInAt  DateTime
  /// Null while the person is still clocked in.
  clockOutAt DateTime?
  note       String?

  /// The show this shift is measured against. Null for shipping, and for a
  /// streamer who clocked in when they were not on anything.
  showId String?

  source    TimeEntrySource @default(SELF)
  /// Bumped on every correction; the revisions below hold what it said before.
  version   Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a show must never delete the record of
  /// somebody's hours. The entry survives and simply stops being clamped.
  show      Show?               @relation(fields: [showId], references: [id], onDelete: SetNull)
  revisions TimeEntryRevision[]

  @@index([userId, clockInAt])
  @@index([clockInAt])
  /// Finding whoever is still clocked in, without scanning the table.
  @@index([userId, clockOutAt])
  @@index([showId])
  /// One person's hours for one show are printed once and once only.
  ///
  /// Enforced in the database by a partial unique index on (userId, showId)
  /// WHERE source = 'SCHEDULE', which Prisma's schema language cannot express —
  /// see the migration. Without it, two pages loading at the same moment as a
  /// show starts would each print a copy and somebody would be paid twice.
}

/// Append-only history of every version a time entry has held.
///
/// Payroll is paid from these hours, so a correction adds a row rather than
/// overwriting one. "It used to say something else" must always be answerable,
/// including for the entry as first recorded.
model TimeEntryRevision {
  id          String    @id @default(cuid())
  timeEntryId String
  version     Int
  clockInAt   DateTime
  clockOutAt  DateTime?
  note        String?
  /// Why it changed. Required for an admin edit, absent on the first record.
  reason      String?
  changedById String
  changedAt   DateTime  @default(now())

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  changedBy User      @relation("TimeEntryChangedBy", fields: [changedById], references: [id])

  @@unique([timeEntryId, version])
  @@index([changedAt])
}

/* ==========================================================================
   Shipping — the morning's order files, the boxes they become, and the
   permanent record of what a packer put in each one.
   ========================================================================== */

/// How an upload ended.
enum ImportStatus {
  /// Parsed and accepted. This is the day's data.
  OK
  /// A file was not what the code expects, or a check failed. No boxes made.
  BLOCKED
  /// An upload from before the checklist, replaced by a later upload of the
  /// same day. The old model never read these; the migration to the new one
  /// marks them so that nothing ever does. Kept, never shown as the day's data.
  SUPERSEDED
}

/// One upload of a show day's order exports.
///
/// Kept as history rather than one row per day: a day can legitimately be
/// uploaded again — a corrected export, a file that was missing first time —
/// and "who loaded what, when, and what it produced" has to stay answerable.
/// The most recent OK batch is the day's data.
model ImportBatch {
  id       String       @id @default(cuid())
  /// Whose report this is, read from the file itself rather than asked for.
  ///
  /// A TikTok export names its own shop in `Creator Handle` — `vaultshowlive`
  /// is watches, `caratclublive` is diamonds — which is the only thing that can
  /// tell two same-day TikTok files apart, since both shows run the same hours.
  /// An eBay export names no seller at all, so that one is resolved from the
  /// day's published schedule instead — see `placeEbayFile`.
  business Business     @default(WATCH)
  showDate DateTime     @db.Date
  status   ImportStatus @default(OK)

  /// Which line of the day's checklist this upload fills.
  ///
  /// A day is not one report. It is a list of files — one per TikTok show, one
  /// per business selling on eBay — and each arrives on its own, whenever it is
  /// ready. So an upload is one file, and these two say which.
  ///
  /// Null on both when the upload was refused before anything could be read,
  /// and `slot` is null for eBay, whose single export covers the whole day
  /// however many shows ran.
  ///
  /// What this buys is that re-uploading a corrected TikTok night file replaces
  /// the TikTok night file and nothing else. Before, a second upload replaced
  /// the day — which is why uploading one missing file would have taken every
  /// other sale and every unpacked box with it.
  platform Platform?
  slot     Slot?

  uploadedById String?
  uploadedAt   DateTime @default(now())

  /// One entry per file: name, platform, sha256, size, row count.
  files Json
  /// Everything the parse wanted to say — blocking, warning and informational.
  flags Json

  watchCount   Int @default(0)
  boxCount     Int @default(0)
  droppedCount Int @default(0)

  uploadedBy User?         @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  sales      SalesRecord[]
  drops      ImportDrop[]
  packages   Package[]

  @@index([showDate, uploadedAt])
  @@index([status, showDate])
  @@index([business, showDate, uploadedAt])
  /// Finding the latest upload for one line of a day's checklist.
  @@index([showDate, business, platform, slot, uploadedAt])
}

/// One paid watch, exactly as `WatchSale` in src/lib/domain/imports.
///
/// Money is stored in whole cents. The schedule already keeps elapsed time as
/// integer hundredths for the same reason: a float is the wrong shape for
/// something that gets totalled and paid.
model SalesRecord {
  id      String @id @default(cuid())
  batchId String

  /// Denormalised from the batch. Sales are totalled, charted and paid on far
  /// more often than they are written, and a diamond show's commission must
  /// never be worked out from a watch show's sales — so the business is on the
  /// row rather than a join away.
  business Business @default(WATCH)

  platform Platform
  /// "TikTok AM", "TikTok PM", "eBay AM", "eBay PM" — where it sold.
  show     String
  showDate DateTime @db.Date

  /// Who is paid for it, which is not the same question as where it sold.
  shiftTag      String
  rawShiftTag   String
  shiftTagValid Boolean @default(true)

  orderRef    String
  lineRef     String
  buyer       String
  /// The stock number. TikTok `Product Name`, eBay `Item Title`.
  stockNumber String
  category    String  @default("")
  qty         Int     @default(1)

  unitPriceCents        Int @default(0)
  platformDiscountCents Int @default(0)
  sellerDiscountCents   Int @default(0)
  /// After both discounts — the headline revenue figure (R14).
  netItemPriceCents     Int @default(0)
  /// Carried through untouched and uninterpreted (R9).
  shippingCents         Int @default(0)
  taxAndFeesCents       Int @default(0)
  orderTotalCents       Int @default(0)

  /// When the marketplace says the order was created. Null on eBay, which
  /// records no time of day at all.
  soldAt DateTime?
  paidOn DateTime? @db.Date

  shipToName    String @default("")
  state         String @default("")
  paymentMethod String @default("")

  /// TikTok's own Package ID. Not a reference to `Package`.
  sourcePackageId String @default("")
  tracking        String @default("")
  sourceFile      String

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([showDate, show])
  @@index([batchId])
  @@index([tracking])
  @@index([shiftTag])
  @@index([business, showDate])
}

/// A raw row that was not counted, and why. The Exceptions sheet.
model ImportDrop {
  id      String @id @default(cuid())
  batchId String

  platform    Platform
  orderRef    String
  buyer       String @default("")
  stockNumber String @default("")
  amountCents Int    @default(0)
  reason      String
  sourceFile  String

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

enum PackageStatus {
  OPEN
  CLOSED_COMPLETE
  CLOSED_INCOMPLETE
  /// Went out, but was never scanned here — a day marked sent in bulk because
  /// it had already shipped, or because the scanner was down. Deliberately not
  /// one of the two above: "complete" would claim a verification that never
  /// happened, and "incomplete" would claim a discrepancy nobody found.
  CLOSED_UNVERIFIED
}

/// One box: one tracking number, one parcel, one buyer.
///
/// Several orders share a box when somebody bought more than once during a
/// show. Tracking is the key rather than TikTok's `Package ID` because eBay has
/// no package column at all, and because the tracking number is the only thing
/// a packer can physically scan.
model Package {
  id             String   @id @default(cuid())
  /// The unique constraint is what makes a box closed for everyone: two
  /// packers scanning the same label cannot create two boxes to close.
  trackingNumber String   @unique
  /// Which show's box this is, for the log and the day's counts.
  ///
  /// It does not gate scanning. The floor packs both piles off one table, and a
  /// tracking number is unique across both, so a scanned label always resolves
  /// to exactly one box whoever is holding it.
  business       Business @default(WATCH)
  platform       Platform
  showDate       DateTime @db.Date

  buyer       String @default("")
  shipToName  String @default("")
  shipToState String @default("")

  status PackageStatus @default(OPEN)
  /// A label that was scanned but was in no uploaded file. Packable anyway;
  /// listed for the Shipping Director to reconcile.
  isUnrecognised Boolean @default(false)

  closedById String?
  closedAt   DateTime?

  /// The upload that first created this box. Null once that batch is gone.
  batchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch    ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  closedBy User?        @relation("PackageClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  items PackageItem[]
  scans ScanEvent[]

  @@index([showDate, status])
  @@index([status])
  @@index([closedById, closedAt])
  @@index([business, showDate, status])
}

/// What belongs in a box, as a count per stock number.
///
/// A count and not a checklist: a real box on 09/08 held stock number 49746
/// three times. As a list of unique items the second scan of an identical
/// barcode reads as a duplicate and gets refused, stranding the packer.
model PackageItem {
  id          String @id @default(cuid())
  packageId   String
  stockNumber String
  expectedQty Int
  scannedQty  Int    @default(0)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, stockNumber])
  @@index([stockNumber])
}

/// What happened at the scanner.
enum ScanKind {
  /// A label was scanned and the box opened.
  LABEL
  ITEM_ACCEPTED
  /// The watch was not in this box. Recorded because a refusal is proof the
  /// control worked and the wrong item was caught.
  ITEM_REFUSED
  /// An unexpected watch was added deliberately, against the data.
  ITEM_OVERRIDE
  /// The tag on a piece sold under a placeholder listing ("LGD #3"). The report
  /// only says "a piece", so this row is the record of which piece went to
  /// that customer: `stockNumber` is the real tag, `note` the listing it sold as.
  ITEM_PLACEHOLDER
  CLOSE_COMPLETE
  CLOSE_INCOMPLETE
  /// Closed in bulk without being scanned, with the reason on the row. So "why
  /// is this box closed with nothing in its history" is answerable from the
  /// history itself.
  CLOSE_UNVERIFIED
  REOPEN
}

/// Append-only log of every scan.
///
/// This is the evidence for a customer who says they were sent the wrong
/// watch: which box, which watch, by whom, at what moment — and what was
/// refused. Rows are never updated or deleted; a correction adds a row.
///
/// About 700 events a day at the real rate of 220 boxes and 473 watches.
model ScanEvent {
  id        String   @id @default(cuid())
  packageId String
  userId    String
  at        DateTime @default(now())
  kind      ScanKind

  /// The watch, for item events. Null on LABEL and the close events.
  stockNumber String?
  /// Exactly what the scanner returned, before matching. Kept so a label that
  /// failed to resolve can be diagnosed rather than guessed at.
  rawScan     String?
  note        String?

  /// Restrict, not Cascade: a box that has been scanned can no longer be
  /// deleted at all. Re-uploading a corrected report may drop a box nobody has
  /// touched, but the moment a packer scans one it becomes evidence, and the
  /// database refuses rather than trusting every future caller to remember.
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  user    User    @relation("ScanBy", fields: [userId], references: [id])

  @@index([packageId, at])
  @@index([userId, at])
  @@index([at])
}
