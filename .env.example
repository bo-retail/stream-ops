# Copy to .env for local development, or set these in the Vercel project settings.

# Neon: use the POOLED connection string (…-pooler.…) for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/streamops?sslmode=require"
# Neon: use the DIRECT (non-pooled) connection string for migrations only.
SHADOW_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/streamops_shadow?sslmode=require"

# Signs session cookies — must be unique per environment and kept secret.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Used only by `npm run db:seed` to create the first boss account.
SEED_BOSS_EMAIL="boss@example.com"
SEED_BOSS_PASSWORD=""
