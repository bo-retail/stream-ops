# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — these hold the database URL and the session signing secret
.env*
!.env.example

# database dumps from scripts/backup-all.mjs — full table contents, including
# every user's password hash. Operational artefacts, never source.
backup-*.json

# throwaway output from scripts/test-excel.mjs
schedule-export-test.xlsx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# scripts/launch-check.mjs — what every day read just before a migration.
# Dates and totals only, but specific to one database at one moment.
launch-before.json
